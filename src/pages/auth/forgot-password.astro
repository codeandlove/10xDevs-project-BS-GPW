---
/**
 * Forgot Password page
 * User enters email to receive password reset link
 */
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Odzyskaj hasło - Black Swan Grid">
  <div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <a href="/" class="mb-6 inline-flex items-center gap-2">
          <span class="text-3xl">🦢</span>
          <span class="text-2xl font-bold">Black Swan Grid</span>
        </a>
        <h1 class="mt-6 text-3xl font-bold">Odzyskaj hasło</h1>
        <p class="mt-2 text-sm text-muted-foreground">
          Wprowadź swój adres email, a wyślemy Ci link do resetowania hasła
        </p>
      </div>

      <div class="rounded-lg border bg-white p-8 shadow-sm">
        <form id="forgot-password-form" class="space-y-4" novalidate>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2"> Email </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              aria-required="true"
              aria-describedby="email-error"
              aria-invalid="false"
              class="block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              placeholder="twoj@email.com"
            />
            <div id="email-error" role="alert" class="mt-1 text-sm text-red-600 hidden"></div>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full rounded-md bg-primary px-4 py-2 text-white font-medium hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Wyślij link resetujący
          </button>

          <div
            id="success-message"
            role="alert"
            class="hidden rounded-md bg-green-50 border border-green-200 p-4 text-sm text-green-800"
          >
            <p class="font-medium">Email wysłany!</p>
            <p class="mt-1">Sprawdź swoją skrzynkę pocztową i kliknij link, aby zresetować hasło.</p>
          </div>

          <div
            id="error-message"
            role="alert"
            class="hidden rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-800"
          >
            <p class="font-medium">Wystąpił błąd</p>
            <p id="error-text" class="mt-1"></p>
          </div>
        </form>

        <div class="mt-6 text-center">
          <a href="/auth/login" class="text-sm text-muted-foreground hover:underline"> Powrót do logowania </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { z } from "zod";
  import { supabaseClient } from "@/db/supabase.client";

  // Validation schema using Zod (consistent with AuthForm)
  const forgotPasswordSchema = z.object({
    email: z.string().email("Proszę podać prawidłowy adres email"),
  });

  const form = document.getElementById("forgot-password-form") as HTMLFormElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const successMessage = document.getElementById("success-message") as HTMLDivElement;
  const errorMessage = document.getElementById("error-message") as HTMLDivElement;
  const errorText = document.getElementById("error-text") as HTMLParagraphElement;
  const emailError = document.getElementById("email-error") as HTMLDivElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Reset messages
    successMessage.classList.add("hidden");
    errorMessage.classList.add("hidden");
    emailError.classList.add("hidden");
    emailError.textContent = "";
    emailInput.setAttribute("aria-invalid", "false");

    const email = emailInput.value.trim();

    // Validate using Zod schema
    const result = forgotPasswordSchema.safeParse({ email });
    if (!result.success) {
      const error = result.error.errors[0];
      emailError.textContent = error.message;
      emailError.classList.remove("hidden");
      emailInput.setAttribute("aria-invalid", "true");
      emailInput.focus();
      return;
    }

    // Disable form during submission
    submitBtn.disabled = true;
    submitBtn.textContent = "Wysyłanie...";

    try {
      const { error } = await supabaseClient.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/auth/reset-password`,
      });

      if (error) {
        throw error;
      }

      // Success - show message
      successMessage.classList.remove("hidden");
      form.reset();

      // Auto-focus on success message for screen readers
      successMessage.focus();
    } catch (err) {
      // Error handling
      errorText.textContent = err instanceof Error ? err.message : "Nie udało się wysłać emaila. Spróbuj ponownie.";
      errorMessage.classList.remove("hidden");
      errorMessage.focus();
    } finally {
      // Re-enable form
      submitBtn.disabled = false;
      submitBtn.textContent = "Wyślij link resetujący";
    }
  });

  // Auto-focus on email input
  emailInput.focus();
</script>
