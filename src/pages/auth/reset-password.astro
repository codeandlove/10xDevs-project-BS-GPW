---
/**
 * Reset Password page
 * User sets new password after clicking reset link from email
 */
import Layout from "@/layouts/Layout.astro";

// Check for error in URL params (Supabase passes error if token invalid)
const errorType = Astro.url.searchParams.get("error");
const errorDescription = Astro.url.searchParams.get("error_description");
---

<Layout title="Ustaw nowe hasło - Black Swan Grid">
  <div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <a href="/" class="mb-6 inline-flex items-center gap-2">
          <span class="text-3xl">🦢</span>
          <span class="text-2xl font-bold">Black Swan Grid</span>
        </a>
        <h1 class="mt-6 text-3xl font-bold">Ustaw nowe hasło</h1>
        <p class="mt-2 text-sm text-muted-foreground">Wprowadź nowe hasło do swojego konta</p>
      </div>

      <div class="rounded-lg border bg-white p-8 shadow-sm">
        {
          errorType && (
            <div role="alert" class="mb-4 rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-800">
              <p class="font-medium">Link wygasł lub jest nieprawidłowy</p>
              <p class="mt-1">{errorDescription || "Link resetujący hasło jest już nieważny."}</p>
              <a href="/auth/forgot-password" class="mt-3 inline-block font-medium underline hover:no-underline">
                Wyślij nowy link resetujący
              </a>
            </div>
          )
        }

        {
          !errorType && (
            <form id="reset-password-form" class="space-y-4" novalidate>
              <div>
                <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
                  Nowe hasło
                </label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  aria-required="true"
                  aria-describedby="password-help password-error"
                  aria-invalid="false"
                  class="block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  placeholder="Minimum 8 znaków"
                />
                <p id="password-help" class="mt-1 text-xs text-gray-500">
                  Minimum 8 znaków
                </p>
                <div id="password-error" role="alert" class="mt-1 text-sm text-red-600 hidden" />
              </div>

              <div>
                <label for="password-confirm" class="block text-sm font-medium text-gray-700 mb-2">
                  Potwierdź hasło
                </label>
                <input
                  type="password"
                  id="password-confirm"
                  name="password-confirm"
                  required
                  aria-required="true"
                  aria-describedby="password-confirm-error"
                  aria-invalid="false"
                  class="block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  placeholder="Powtórz hasło"
                />
                <div id="password-confirm-error" role="alert" class="mt-1 text-sm text-red-600 hidden" />
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full rounded-md bg-primary px-4 py-2 text-white font-medium hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Zmień hasło
              </button>

              <div
                id="error-message"
                role="alert"
                class="hidden rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-800"
              >
                <p class="font-medium">Wystąpił błąd</p>
                <p id="error-text" class="mt-1" />
                <a href="/auth/forgot-password" class="mt-3 inline-block font-medium underline hover:no-underline">
                  Wyślij nowy link resetujący
                </a>
              </div>
            </form>
          )
        }

        <div class="mt-6 text-center">
          <a href="/auth/login" class="text-sm text-muted-foreground hover:underline"> Powrót do logowania </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  /* eslint-disable prettier/prettier */
  import { z } from "zod";
  import { supabaseClient } from "@/db/supabase.client";
  /* eslint-enable prettier/prettier */

  // Validation schema using Zod (consistent with AuthForm)
  const resetPasswordSchema = z
    .object({
      password: z.string().min(8, "Hasło musi mieć minimum 8 znaków"),
      passwordConfirm: z.string(),
    })
    .refine((data) => data.password === data.passwordConfirm, {
      message: "Hasła nie są identyczne",
      path: ["passwordConfirm"],
    });

  const form = document.getElementById("reset-password-form") as HTMLFormElement | null;

  if (form) {
    const passwordInput = document.getElementById("password") as HTMLInputElement;
    const passwordConfirmInput = document.getElementById("password-confirm") as HTMLInputElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const errorMessage = document.getElementById("error-message") as HTMLDivElement;
    const errorText = document.getElementById("error-text") as HTMLParagraphElement;
    const passwordError = document.getElementById("password-error") as HTMLDivElement;
    const passwordConfirmError = document.getElementById("password-confirm-error") as HTMLDivElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Reset error messages
      errorMessage.classList.add("hidden");
      passwordError.classList.add("hidden");
      passwordConfirmError.classList.add("hidden");
      passwordError.textContent = "";
      passwordConfirmError.textContent = "";
      passwordInput.setAttribute("aria-invalid", "false");
      passwordConfirmInput.setAttribute("aria-invalid", "false");

      const password = passwordInput.value;
      const passwordConfirm = passwordConfirmInput.value;

      // Validate using Zod schema
      const result = resetPasswordSchema.safeParse({ password, passwordConfirm });
      if (!result.success) {
        let hasError = false;
        result.error.errors.forEach((err) => {
          if (err.path[0] === "password") {
            passwordError.textContent = err.message;
            passwordError.classList.remove("hidden");
            passwordInput.setAttribute("aria-invalid", "true");
            hasError = true;
          }
          if (err.path[0] === "passwordConfirm") {
            passwordConfirmError.textContent = err.message;
            passwordConfirmError.classList.remove("hidden");
            passwordConfirmInput.setAttribute("aria-invalid", "true");
            hasError = true;
          }
        });

        if (hasError) {
          passwordInput.focus();
          return;
        }
      }

      // Disable form during submission
      submitBtn.disabled = true;
      submitBtn.textContent = "Zmieniam hasło...";

      try {
        const { error } = await supabaseClient.auth.updateUser({
          password: password,
        });

        if (error) {
          throw error;
        }

        // Success - redirect to login with success message
        window.location.href = "/auth/login?password_reset=success";
      } catch (err) {
        // Error handling
        errorText.textContent = err instanceof Error ? err.message : "Nie udało się zmienić hasła. Link mógł wygasnąć.";
        errorMessage.classList.remove("hidden");
        errorMessage.focus();

        // Re-enable form
        submitBtn.disabled = false;
        submitBtn.textContent = "Zmień hasło";
      }
    });

    // Auto-focus on password input
    passwordInput.focus();
  }
</script>
