---
/**
 * Landing page - home view
 * Static Astro page with hero section and CTAs
 */
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
---

<Layout title="Black Swan Grid - Identyfikuj anomalie GPW z AI">
  <div class="flex min-h-screen flex-col">
    <!-- Header -->
    <header class="border-b">
      <div class="container mx-auto flex h-16 items-center justify-between px-4">
        <div class="flex items-center gap-2">
          <span class="text-2xl">🦢</span>
          <span class="text-xl font-bold">Black Swan Grid</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/auth/login" class="text-sm font-medium hover:underline"> Zaloguj się </a>
          <a href="/auth/register">
            <Button>Rozpocznij trial</Button>
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="flex flex-1 items-center bg-gradient-to-b from-gray-50 to-white py-20">
      <div class="container mx-auto px-4 text-center">
        <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-6xl">
          Wykrywaj anomalie cenowe GPW
          <span class="text-primary"> z pomocą AI</span>
        </h1>
        <p class="mx-auto mb-8 max-w-2xl text-lg text-muted-foreground md:text-xl">
          Black Swan Grid to interaktywna platforma do analizy historycznych zdarzeń Black Swan na Giełdzie Papierów
          Wartościowych w Warszawie. Szybko identyfikuj wzorce, otrzymuj podsumowania AI i podejmuj lepsze decyzje
          inwestycyjne.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/auth/register">
            <Button size="lg" class="min-w-[200px]"> Rozpocznij 7-dniowy trial </Button>
          </a>
          <a href="/auth/login">
            <Button size="lg" variant="outline" class="min-w-[200px]"> Zaloguj się </Button>
          </a>
        </div>

        <p class="mt-4 text-sm text-muted-foreground">Pierwszy tydzień za darmo. Nie wymagamy karty kredytowej.</p>
      </div>
    </section>

    <!-- Features Section -->
    <section class="border-t py-20">
      <div class="container mx-auto px-4">
        <h2 class="mb-12 text-center text-3xl font-bold">Kluczowe funkcje</h2>

        <div class="grid gap-8 md:grid-cols-3">
          <!-- Feature 1 -->
          <div class="text-center">
            <div class="mb-4 flex justify-center">
              <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
                <span class="text-3xl">📊</span>
              </div>
            </div>
            <h3 class="mb-2 text-xl font-semibold">Interaktywny grid</h3>
            <p class="text-muted-foreground">
              Przeglądaj historyczne anomalie cenowe w przejrzystym, interaktywnym gridzie. Filtruj po tickerach i
              zakresach czasowych.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="text-center">
            <div class="mb-4 flex justify-center">
              <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
                <span class="text-3xl">🤖</span>
              </div>
            </div>
            <h3 class="mb-2 text-xl font-semibold">AI Summaries</h3>
            <p class="text-muted-foreground">
              Otrzymuj podsumowania zdarzeń wygenerowane przez AI, z analizą sentymentu, przyczyn i prognoz trendu.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="text-center">
            <div class="mb-4 flex justify-center">
              <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
                <span class="text-3xl">⚡</span>
              </div>
            </div>
            <h3 class="mb-2 text-xl font-semibold">Szybki dostęp</h3>
            <p class="text-muted-foreground">
              Zaawansowany cache i lazy loading zapewniają błyskawiczne ładowanie danych i płynne przewijanie.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="border-t bg-gray-50 py-20">
      <div class="container mx-auto px-4 text-center">
        <h2 class="mb-4 text-3xl font-bold">Gotowy na start?</h2>
        <p class="mb-8 text-lg text-muted-foreground">
          Rozpocznij 7-dniowy bezpłatny trial i zacznij odkrywać anomalie GPW już dziś.
        </p>
        <a href="/auth/register">
          <Button size="lg" class="min-w-[250px]"> Wypróbuj za darmo </Button>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t py-8">
      <div class="container mx-auto px-4 text-center text-sm text-muted-foreground">
        <p>&copy; 2025 Black Swan Grid. Wszystkie prawa zastrzeżone.</p>
      </div>
    </footer>
  </div>
</Layout>
